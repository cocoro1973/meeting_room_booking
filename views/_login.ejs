<%- include('partials/header', { title: 'ログイン' }) %>

<div class="space-y-10 max-w-7xl mx-auto">
    <!-- 1. ログインフォーム（中央配置） -->
    <div class="max-w-xs mx-auto bg-white p-5 rounded-2xl shadow-lg border border-gray-100">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center flex items-center justify-center gap-2">
            <i class="ph ph-sign-in text-indigo-600"></i>
            三輪病院　会議室予約
        </h2>
        
        <!-- エラーメッセージ -->
        <% if (typeof error !== 'undefined' && error) { %> 
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-md">
                <p class="text-sm text-red-700 font-bold flex items-center gap-2">
                    <i class="ph ph-warning-circle text-lg"></i>
                    <%= error %>
                </p>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">会議名</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="ph ph-user text-gray-400 text-lg"></i>
                    </div>
                    <input type="text" list="meetings" name="username" required 
                           placeholder="[admin] で管理者画面へ" 
                           class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-gray-50 focus:bg-white text-gray-800">
                    <datalist id="meetings">
                        <% if (typeof presetMeetings !== 'undefined') { %>
                            <% presetMeetings.forEach(u => { %>
                                <option value="<%= u %>"></option>
                            <% }) %>
                        <% } %>
                    </datalist>
                </div>
            </div>
            
            <button type="submit" 
                    class="w-full bg-indigo-600 text-white font-bold py-2 px-4 rounded-lg hover:bg-indigo-700 hover:shadow-md transition-all flex justify-center items-center gap-2">
                ログイン
                <i class="ph ph-arrow-right"></i>
            </button>
        </form>
    </div>

    <!-- 2. 予約状況（1週間タイムライン） -->
    <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                <i class="ph ph-calendar-blank text-indigo-600 text-2xl"></i>
                現在の予約状況
            </h2>
            <span class="text-xs font-semibold px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full border border-indigo-100">
                週間スケジュール
            </span>
            <!-- ⭕ 1週間移動ナビゲーションボタン -->
            <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
                <!-- １週間前へ -->
                <a href="/?startDate=<%= prevWeekStr %>" 
                   class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-lg transition-colors flex items-center gap-1 shadow-sm">
                    <i class="ph ph-caret-left"></i>
                    1週間前
                </a>

                <!-- 今日にする（offset=0） -->
                <a href="/" 
                   class="px-3 py-1.5 <%= (typeof weekOffset === 'undefined' || weekOffset === 0) ? 'bg-indigo-600 text-white font-bold' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %> text-xs rounded-lg transition-colors shadow-sm flex items-center gap-1">
                    <i class="ph ph-clock text-sm"></i>
                    今日
                </a>

                <!-- １週間進める -->
                <a href="/?startDate=<%= nextWeekStr %>" 
                   class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-lg transition-colors flex items-center gap-1 shadow-sm">
                    1週間進む
                    <i class="ph ph-caret-right"></i>
                </a>
            </div>
        </div>

        <% if (rooms.length === 0) { %>
            <div class="text-center py-12 text-gray-400">
                <i class="ph ph-door-open text-4xl mb-2 block"></i>
                <p>会議室が登録されていません。</p>
            </div>
        <% } else { %>
            <!-- 横スクロール可能枠 -->
            <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
                <table class="w-full border-collapse text-left">
                    <thead>
                        <tr class="bg-gray-50 text-gray-700 text-sm font-semibold border-b border-gray-200">
                            <!-- 左端：会議室カラム -->
                            <th class="p-4 w-44 min-w-[160px] bg-gray-100/80 text-gray-900 border-r border-gray-200">
                                <div class="flex items-center gap-1.5">
                                    <i class="ph ph-door text-indigo-600 text-lg"></i>
                                    会議室
                                </div>
                            </th>
                            <!-- 日付ヘッダー -->
                            <% timelineDates.forEach(t => { %>
                                <th class="p-3 text-center min-w-[130px] border-r border-gray-200 last:border-r-0">
                                    <span class="block text-xs font-bold text-gray-700"><%= t.label %></span>
                                </th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 text-sm">
                        <% rooms.forEach(room => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <!-- 会議室名 -->
                                <td class="p-4 font-bold text-gray-800 bg-gray-50/80 border-r border-gray-200 align-top">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                                        <%= room.name %>
                                    </div>
                                </td>
                                
                                <!-- 日付ごとのコマ -->
                                <% timelineDates.forEach(t => { %>
                                    <td class="p-2 border-r border-gray-200 last:border-r-0 align-top h-28 min-w-[130px] bg-white">
                                        <% 
                                            const dayBookings = bookings.filter(b => b.roomName === room.name && b.date === t.dateStr);
                                            dayBookings.sort((a, b) => a.startTime.localeCompare(b.startTime));
                                        %>
                                        <% if (dayBookings.length > 0) { %>
                                            <div class="space-y-1.5">
                                                <% dayBookings.forEach(b => { %>
                                                    <!-- 予約枠カード -->
                                                    <div class="bg-indigo-50/80 hover:bg-indigo-100/80 border border-indigo-200/80 rounded-lg p-2 transition-all text-xs text-indigo-950 shadow-sm">
                                                        <div class="font-bold text-indigo-700 flex items-center gap-1 mb-1">
                                                            <i class="ph ph-clock text-indigo-500"></i>
                                                            <%= b.startTime %> - <%= b.endTime %>
                                                        </div>
                                                        <div class="flex items-center gap-1 text-gray-600 truncate">
                                                            <i class="ph ph-user text-gray-400"></i>
                                                            <span class="truncate"><%= b.user %></span>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="h-full flex items-center justify-center text-gray-300 font-light text-xs">
                                                -
                                            </div>
                                        <% } %>
                                    </td>
                                <% }) %>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>