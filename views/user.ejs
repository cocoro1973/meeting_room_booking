<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>会議室予約</title>
</head>
<body>
    <h1>こんにちは、<%= user %> さん</h1>
    <a href="/logout">ログアウト</a>

    <h2>予約状況一覧</h2>

    <div style="margin-bottom: 15px; font-size: 1.1em;">
        <a href="/user?startDate=<%= prevWeekStr %>" style="text-decoration: none; margin-right: 20px;">[ &lt;&lt; 1週間前へ ]</a>
        <a href="/user" style="text-decoration: none; margin-right: 20px;">[ 今日にする ]</a>
        <a href="/user?startDate=<%= nextWeekStr %>" style="text-decoration: none;">[ &gt;&gt; 1週間進める ]</a>
    </div>

    <% if (rooms.length === 0) { %>
        <p>会議室が登録されていません。</p>
    <% } else { %>
        <table border="1" style="border-collapse: collapse; text-align: center; width: 100%;">
            <thead>
                <tr style="background-color: #f2f2f2;">
                    <th style="min-width: 100px;">会議室</th>
                    <% timelineDates.forEach(t => { %>
                        <th style="min-width: 90px; padding: 5px;"><%= t.label %></th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
                <% rooms.forEach(room => { %>
                    <tr>
                        <td style="background-color: #fafafa; font-weight: bold; padding: 10px;"><%= room.name %></td>
                        <% timelineDates.forEach(t => { %>
                            <td style="vertical-align: top; padding: 5px; font-size: 0.85em; height: 60px;">
                                <% 
                                    // この部屋かつ、この日付の予約を抽出
                                    const dayBookings = bookings.filter(b => b.roomName === room.name && b.date === t.dateStr);
                                    // 開始時間の早い順にソート
                                    dayBookings.sort((a, b) => a.startTime.localeCompare(b.startTime));
                                %>
                                <% if (dayBookings.length > 0) { %>
                                    <% dayBookings.forEach(b => { %>
                                        <div style="background-color: #e6f7ff; border: 1px solid #91d5ff; border-radius: 3px; margin-bottom: 3px; padding: 2px; text-align: left;">
                                            <strong><%= b.startTime %>-<%= b.endTime %></strong><br>
                                            <%= b.user %>さん
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <span style="color: #ccc;">-</span>
                                <% } %>
                            </td>
                        <% }) %>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
    <br>

    <h2>あなたの予約一覧</h2>
    <% if (myBookings.length === 0) { %>
        <p>現在予約はありません。</p>
    <% } else { %>
        <ul>
            <% myBookings.forEach(b => { %>
                <li style="margin-bottom: 8px;">
                    [<%= b.roomName %>] <%= b.date %> : <%= b.startTime %> ～ <%= b.endTime %>
                    <form action="/user/book/delete/<%= b.id %>" method="POST" style="display:inline; margin-left: 10px;">
                        <button type="submit" onclick="return confirm('この予約をキャンセルしますか？')">キャンセル</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } %>

    <h2>新しく会議室を予約する</h2>
    <% if (error) { %> <p style="color: red;"><%= error %></p> <% } %>
    
    <% if (rooms.length === 0) { %>
        <p>利用可能な会議室がありません（管理者が追加するまでお待ちください）。</p>
    <% } else { %>
        <form action="/user/book" method="POST">
            <label>会議室:</label>
            <select name="roomName" required>
                <% rooms.forEach(room => { %>
                    <option value="<%= room.name %>"><%= room.name %></option>
                <% }) %>
            </select>
            <br><br>

            <label>日付:</label>
            <input type="date" name="date" required>
            <br><br>

            <label>時間帯:</label>
            <input type="time" name="startTime" required> ～ 
            <input type="time" name="endTime" required>
            <br><br>

            <button type="submit">予約する</button>
        </form>
    <% } %>

</body>
</html>