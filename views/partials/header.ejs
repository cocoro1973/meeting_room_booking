<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | 予約システム' : '会議室予約システム' %></title>
    
    <!-- Tailwind CSS (CDN) でモダンなスタイリング -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts (Noto Sans JP) -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- アイコンライブラリ (Phosphor Icons) -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: #f8fafc; /* 優しいオフホワイトの背景 */
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* フッターを常に最下部に固定するため */
        }
        main {
            flex-grow: 1;
        }
    </style>
</head>
<body>
    <!-- ヘッダーナビゲーション -->
    <header class="bg-indigo-600 text-white shadow-md">
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | 予約システム' : '会議室予約システム' %></title>
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- アイコンライブラリ -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <!-- ⭕ 自作の外部CSSファイルを読み込む -->
    <link rel="stylesheet" href="/css/style.css">
    </header>
    
    <!-- メインコンテンツの開始 (footer.ejsで閉じます) -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">