<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>管理者画面</title>
</head>
<body>
    <h1>管理者ダッシュボード</h1>
    <a href="/logout">ログアウト</a>
    <hr>

    <h2>会議室の管理</h2>
    <form action="/admin/rooms/add" method="POST">
        <input type="text" name="roomName" placeholder="新しい会議室名" required>
        <button type="submit">会議室を追加</button>
    </form>

    <ul>
        <% rooms.forEach(room => { %>
            <li>
                <%= room.name %>
                <form action="/admin/rooms/delete/<%= room.id %>" method="POST" style="display:inline;">
                    <button type="submit">削除</button>
                </form>
            </li>
        <% }) %>
    </ul>

    <hr>
    <h2>現在の全予約状況</h2>
    <table border="1">
        <tr>
            <th>会議室</th>
            <th>予約者</th>
            <th>日付</th>
            <th>時間</th>
        </tr>
        <% bookings.forEach(b => { %>
            <tr>
                <td><%= b.roomName %></td>
                <td><%= b.user %></td>
                <td><%= b.date %></td>
                <td><%= b.startTime %> ～ <%= b.endTime %></td>
            </tr>
        <% }) %>
    </table>
    <h2>未来2週間の予約状況（タイムライン表示）</h2>
<table border="1" style="border-collapse: collapse; text-align: center; width: 100%;">
<thead>
<tr style="background-color: #f2f2f2;">
    <th style="min-width: 100px;">会議室</th>
    <% timelineDates.forEach(t => { %>
        <th style="min-width: 90px; padding: 5px;"><%= t.label %></th>
    <% }) %>
</tr>
</thead>
<tbody>
<% rooms.forEach(room => { %>
    <tr>
        <td style="background-color: #fafafa; font-weight: bold; padding: 10px;"><%= room.name %></td>
        <% timelineDates.forEach(t => { %>
            <td style="vertical-align: top; padding: 5px; font-size: 0.85em; height: 60px;">
                <% 
                    const dayBookings = bookings.filter(b => b.roomName === room.name && b.date === t.dateStr);
                    dayBookings.sort((a, b) => a.startTime.localeCompare(b.startTime));
                %>
                <% if (dayBookings.length > 0) { %>
                    <% dayBookings.forEach(b => { %>
                        <div style="background-color: #fffbe6; border: 1px solid #ffe58f; border-radius: 3px; margin-bottom: 3px; padding: 2px; text-align: left;">
                            <strong><%= b.startTime %>-<%= b.endTime %></strong><br>
                            <%= b.user %>
                        </div>
                    <% }) %>
                <% } else { %>
                    <span style="color: #ccc;">-</span>
                <% } %>
            </td>
        <% }) %>
    </tr>
<% }) %>
</tbody>
</table>
</body>
</html>