<%- include('partials/header', { title: '管理者ダッシュボード' }) %>

<div class="space-y-8 max-w-7xl mx-auto">

    <!-- 1. 管理者ヘッダー -->
    <div class="bg-slate-800 rounded-2xl p-6 text-white shadow-lg flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <div class="flex items-center gap-2 text-slate-300 text-xs font-semibold mb-1">
                <span class="px-2 py-0.5 bg-slate-700 rounded-md">管理者専用</span>
                <span>システム管理</span>
            </div>
            <h1 class="text-2xl font-bold flex items-center gap-2">
                <i class="ph ph-shield-check text-indigo-400"></i>
                管理者ダッシュボード
            </h1>
        </div>
        <a href="/logout" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-4 py-2 rounded-lg text-sm transition-colors flex items-center gap-1.5 backdrop-blur-sm">
            <i class="ph ph-sign-out"></i>
            ログアウト
        </a>
    </div>

    <!-- 2. 予約状況（タイムライン表示） -->
    <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-gray-100">
            <div class="flex items-center gap-3">
                <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                    <i class="ph ph-calendar-blank text-indigo-600 text-2xl"></i>
                    予約状況（タイムライン）
                </h2>
                <span class="text-xs font-semibold px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full border border-indigo-100 hidden md:inline-block">
                    スケジュール確認
                </span>
            </div>

            <!-- 1週間移動ナビゲーションボタン (/admin 宛て) -->
            <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
                <a href="/admin?startDate=<%= typeof prevWeekStr !== 'undefined' ? prevWeekStr : '' %>" 
                   class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-lg transition-colors flex items-center gap-1 shadow-sm">
                    <i class="ph ph-caret-left"></i>
                    1週間前
                </a>

                <a href="/admin" 
                   class="px-3 py-1.5 bg-gray-100 text-gray-600 hover:bg-gray-200 text-xs font-semibold rounded-lg transition-colors shadow-sm flex items-center gap-1">
                    <i class="ph ph-clock text-sm"></i>
                    今日
                </a>

                <a href="/admin?startDate=<%= typeof nextWeekStr !== 'undefined' ? nextWeekStr : '' %>" 
                   class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-lg transition-colors flex items-center gap-1 shadow-sm">
                    1週間進む
                    <i class="ph ph-caret-right"></i>
                </a>
            </div>
        </div>

        <% if (rooms.length === 0) { %>
            <div class="text-center py-12 text-gray-400">
                <i class="ph ph-door-open text-4xl mb-2 block"></i>
                <p>会議室が登録されていません。</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
                <table class="w-full border-collapse text-left">
                    <thead>
                        <tr class="bg-gray-50 text-gray-700 text-sm font-semibold border-b border-gray-200">
                            <th class="p-4 w-44 min-w-[160px] bg-gray-100/80 text-gray-900 border-r border-gray-200">
                                <div class="flex items-center gap-1.5">
                                    <i class="ph ph-door text-indigo-600 text-lg"></i>
                                    会議室
                                </div>
                            </th>
                            <% timelineDates.forEach(t => { %>
                                <th class="p-3 text-center min-w-[130px] border-r border-gray-200 last:border-r-0">
                                    <span class="block text-xs font-bold text-gray-700"><%= t.label %></span>
                                </th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 text-sm">
                        <% rooms.forEach(room => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 font-bold text-gray-800 bg-gray-50/80 border-r border-gray-200 align-top">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                                        <%= room.name %>
                                    </div>
                                </td>
                                
                                <% timelineDates.forEach(t => { %>
                                    <td class="p-2 border-r border-gray-200 last:border-r-0 align-top h-28 min-w-[130px] bg-white">
                                        <% 
                                            const dayBookings = bookings.filter(b => b.roomName === room.name && b.date === t.dateStr);
                                            dayBookings.sort((a, b) => a.startTime.localeCompare(b.startTime));
                                        %>
                                        <% if (dayBookings.length > 0) { %>
                                            <div class="space-y-1.5">
                                                <% dayBookings.forEach(b => { %>
                                                    <div class="bg-amber-50/90 hover:bg-amber-100/90 border border-amber-200 rounded-lg p-2 transition-all text-xs text-amber-950 shadow-sm">
                                                        <div class="font-bold text-amber-800 flex items-center gap-1 mb-1">
                                                            <i class="ph ph-clock text-amber-600"></i>
                                                            <%= b.startTime %> - <%= b.endTime %>
                                                        </div>
                                                        <div class="flex items-center gap-1 text-gray-700 truncate">
                                                            <i class="ph ph-user text-gray-400"></i>
                                                            <span class="truncate"><%= b.user %></span>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="h-full flex items-center justify-center text-gray-300 font-light text-xs">
                                                -
                                            </div>
                                        <% } %>
                                    </td>
                                <% }) %>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- 下段2列レイアウト（会議室管理 ＆ 全予約一覧） -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- 3. 会議室の管理 (1列分) -->
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100 lg:col-span-1 space-y-6">
            <h2 class="text-xl font-bold text-gray-800 pb-4 border-b border-gray-100 flex items-center gap-2">
                <i class="ph ph-gear-six text-indigo-600 text-2xl"></i>
                会議室の管理
            </h2>

            <!-- 新規追加フォーム -->
            <form action="/admin/rooms/add" method="POST" class="space-y-3">
                <label class="block text-xs font-semibold text-gray-700">新規会議室の追加</label>
                <div class="flex gap-2">
                    <div class="relative flex-1">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="ph ph-door text-gray-400 text-base"></i>
                        </div>
                        <input type="text" name="roomName" placeholder="会議室名を入力" required
                               class="w-full pl-9 pr-3 py-2 text-xs border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-gray-50 focus:bg-white text-gray-800">
                    </div>
                    <button type="submit" 
                            class="bg-indigo-600 text-white font-bold py-2 px-3 text-xs rounded-lg hover:bg-indigo-700 transition-colors flex items-center gap-1 shrink-0">
                        <i class="ph ph-plus"></i>
                        追加
                    </button>
                </div>
            </form>

            <!-- 会議室一覧 -->
            <div class="space-y-2 pt-2">
                <span class="block text-xs font-semibold text-gray-500 mb-2">登録済み会議室</span>
                <% if (rooms.length === 0) { %>
                    <p class="text-xs text-gray-400 py-4 text-center">会議室が登録されていません。</p>
                <% } else { %>
                    <ul class="space-y-2">
                        <% rooms.forEach(room => { %>
                            <li class="p-3 bg-gray-50 rounded-xl border border-gray-200 flex items-center justify-between gap-2">
                                <span class="text-xs font-bold text-gray-800 flex items-center gap-1.5">
                                    <i class="ph ph-door text-indigo-500 text-base"></i>
                                    <%= room.name %>
                                </span>
                                <form action="/admin/rooms/delete/<%= room.id %>" method="POST" onsubmit="return confirm('この会議室を削除しますか？');">
                                    <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 px-2.5 py-1 rounded-md hover:bg-red-50 transition-colors">
                                        削除
                                    </button>
                                </form>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>
        </div>

        <!-- 4. 現在の全予約状況一覧 (2列分) -->
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100 lg:col-span-2">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-gray-100">
                <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                    <i class="ph ph-list-bullets text-indigo-600 text-2xl"></i>
                    現在の全予約一覧
                </h2>
                <span class="text-xs font-semibold text-gray-500">
                    全 <%= bookings.length %> 件
                </span>
            </div>

            <% if (bookings.length === 0) { %>
                <div class="text-center py-12 text-gray-400">
                    <i class="ph ph-tray text-4xl mb-2 block"></i>
                    <p class="text-sm">予約データが存在しません。</p>
                </div>
            <% } else { %>
                <div class="overflow-x-auto rounded-xl border border-gray-200">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-gray-700 font-semibold border-b border-gray-200">
                                <th class="p-3">会議室</th>
                                <th class="p-3">予約者</th>
                                <th class="p-3">利用日</th>
                                <th class="p-3">時間帯</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-gray-800">
                            <% bookings.forEach(b => { %>
                                <tr class="hover:bg-gray-50/80 transition-colors">
                                    <td class="p-3 font-bold text-indigo-600">
                                        <%= b.roomName %>
                                    </td>
                                    <td class="p-3 font-semibold text-gray-700">
                                        <div class="flex items-center gap-1">
                                            <i class="ph ph-user text-gray-400"></i>
                                            <%= b.user %>
                                        </div>
                                    </td>
                                    <td class="p-3 font-mono text-gray-600">
                                        <%= b.date %>
                                    </td>
                                    <td class="p-3 font-mono">
                                        <%= b.startTime %> ～ <%= b.endTime %>
                                    </td>
                                    <!-- ⭕ 全予約一覧からの削除ボタンのみ維持 -->
                                    <td class="p-3 text-right">
                                        <form action="/admin/bookings/delete/<%= b.id %>" method="POST" onsubmit="return confirm('この予約を削除しますか？');">
                                            <button type="submit" class="px-2.5 py-1 text-xs font-bold text-red-600 hover:text-white border border-red-200 hover:bg-red-600 rounded-lg transition-all flex items-center gap-1 ml-auto shadow-sm">
                                                <i class="ph ph-trash text-sm"></i>
                                                削除
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

    </div>

</div>

<%- include('partials/footer') %>